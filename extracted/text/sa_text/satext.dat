10910 = 명품 패턴 디자인으로 외관을\r\n\r\n개량하여 제작된 스페셜 럭셔리 버전\r\n\r\nTRG21(IK) Luxury를 100%획득할 수\r\n\r\n있는 절호의 찬스!\r\n\r\n\r\n[기본 아이템 구성]\r\n\r\nTRG21(IK) Luxury\r\n\r\n위 아이템을 최소 30일에서\r\n\r\n최대 360일까지 획득 가능!!\r\n\r\n\r\n[보너스 지급]\r\n\r\n스카우터(1~3일) 중, 1개 획득
10911 = M4A1럭셔리상자
10912 = 명품 패턴 디자인으로 외관을\r\n개량하여 제작된 스페셜 럭셔리 버전 \r\nM4A1(IS) Luxury를 100%획득할 수\r\n있는 절호의 찬스!
10913 = 명품 패턴 디자인으로 외관을\r\n\r\n개량하여 제작된 스페셜 럭셔리 버전\r\n\r\nM4A1(IS) Luxury를 100%획득할 수\r\n\r\n있는 절호의 찬스!\r\n\r\n\r\n[기본 아이템 구성]\r\n\r\nM4A1(IS) Luxury\r\n\r\n위 아이템을 최소 30일에서\r\n\r\n최대 360일까지 획득 가능!!\r\n\r\n\r\n[보너스 지급]\r\n\r\n스카우터(1~3일) 중, 1개 획득
10914 = <color=ff0000>지금 가이드를 종료하시면 더 이상 가이드를</color>\r\n\r\n<color=ff0000>진행할 수 없습니다.</color>\r\n\r\n가이드를 종료하시겠습니까?
10915 = 게임을 1판 완료 하시면 다음 가이드가 진행 됩니다.
10916 = 게임을 1판 완료 하시고\r\n\r\n하사 1호봉 계급을 달성하시면 다음 가이드가 진행됩니다.
10917 = 게임을 1판 완료 하시고\r\n\r\n중사 1호봉 계급을 달성하시면 다음 가이드가 진행됩니다.
10918 = <color=FF9000>걷기 기능</color>\r\n\r\nShift키를 누르고 이동하면 천천히 걷습니다.\r\n\r\n걷기로 움직이면 발소리가 들리지 않으며\r\n\r\n사격할 때 총기반동이 줄어듭니다.
10919 = <color=FF9000>장착 무기 별 이동속도</color>\r\n\r\n무기 별로 소지했을 때 무게가 다르기 때문에\r\n\r\n근접무기(3번)을 장착하면 빠르게 이동할 수 있으며,\r\n\r\n주무기(1번)을 장착하면 이동속도가 저하됩니다.
10920 = <color=FF9000>수류탄 투척</color>\r\n\r\n투척무기(4번)을 선택하여 수류탄을\r\n\r\n소지할 수 있으며 움직이거나 점프하여 사용하면\r\n\r\n먼 곳까지 날아갑니다.
10921 = <color=FF9000>높이점프</color>\r\n\r\nCtrl버튼을 눌러 앉은 상태에서 점프하면\r\n\r\n보다 더 높게 점프할 수 있습니다.\r\n
10922 = <color=FF9000>앉아 쏴</color>\r\n\r\nCtrl버튼을 눌러 앉은 상태에서 사격하면\r\n\r\n총기 반동이 가장 많이 줄어듭니다.
10923 = <color=FF9000>끊어 쏴</color>\r\n\r\n왼쪽 마우스를 누른 상태로 계속 사격하면 \r\n\r\n명중률이 떨어집니다.\r\n\r\n총기특성에 따라 1~3발씩 끊어 쏘는게 효과적입니다.
10924 = <color=FF9000>상탄조절</color>\r\n\r\n사격할 때는 반동으로 인해 조준점이 올라갑니다.\r\n\r\n마우스를 조금씩 내리면서 조준점을 맞추는 것이\r\n\r\n중요합니다.
10925 = <color=FF9000>엄폐물 활용</color>\r\n\r\n맵 곳곳에 배치된 엄폐물을 활용하세요.\r\n\r\n엄폐물 뒤에 숨거나, 엄폐물을 활용하여\r\n\r\n좌/우이동 사격하면 쉽게 적을 제압할 수 있습니다.\r\n
10926 = <color=FF9000>무기 교체</color>\r\n\r\n게임 초반 ‘N’키를 사용해 무기를 교체할 수 있습니다.\r\n\r\n미리 슬롯에 등록된 무기만 교체가 가능하며\r\n\r\n슬롯등록은 상점/창고 메뉴에서 설정합니다.
10927 = <color=FF9000>무기 스위치</color>\r\n\r\n단축키 ‘Q’를 통해\r\n\r\n이전에 사용했던 무기로 빠르게 교체할 수 있습니다.
10928 = <color=FF9000>아군 정보 확인</color>\r\n\r\n‘F5’키를 통해 아군 캐릭터 머리 위에\r\n\r\n닉네임/계급/킬/데스 /거리 등을 표시할 수 있습니다.
10929 = <color=FF9000>무빙 샷</color>\r\n\r\n앞, 뒤로 이동하며 총을 쏘면 명중률이 떨어지고,\r\n\r\n제자리에서 쏘면 상대방에게 피격 당하기 쉽습니다.\r\n\r\n따라서 좌/우로 무빙하며 총을 쏘시는 것이 좋습니다.
10930 = <color=FF9000>AK-47</color>\r\n\r\n데미지가 높지만, 반동이 커서 명중률이 낮습니다.\r\n\r\n컨트롤에 자신 있고, 강한 파괴력을 좋아하시는\r\n\r\n분들에게 추천합니다.
10931 = <color=FF9000>M4A1</color>\r\n\r\n평균적인 데미지를 갖고 있는 돌격소총으로\r\n\r\n반동이 적고 명중률이 높은 편입니다.\r\n\r\n정교한 사격을 원하시는 유저에게 추천합니다.
10932 = <color=FF9000>CM901</color>\r\n\r\nAK-47과 M4A1의 중간 성능을 보이는 총으로\r\n\r\n적절한 데미지와 명중률을 갖춘 균형 잡힌 총기입니다.\r\n\r\n게임을 처음 시작하는 분들에게 강력 추천합니다.
10933 = <color=FF9000>TRG-21</color>\r\n\r\n먼 거리의 적을 한 방에 제압할 수 있는 저격소총으로\r\n\r\n비교적 상대방을 맞추기가 힘들기 때문에,\r\n\r\n어느 정도 게임에 숙달된 분들에게 권장합니다.
10934 = <color=FF9000>Aks-74u</color>\r\n\r\nAK-47 개량형 서브머신건으로 반동이 낮고 \r\n\r\n집탄율이 높은 대신 데미지가 낮은 총입니다.\r\n\r\n무게가 가벼워, 착용 시 빠르게 이동할 수 있습니다.
10935 = <color=FF9000>SG-870</color>\r\n\r\n근거리에서 강력한 데미지를 갖고 있는 샷건입니다.\r\n\r\n단, 격발 후 딜레이가 길어 연사력이 떨어집니다.\r\n\r\n근거리의 강력한 한방을 원하시는 분에게 추천합니다.
10936 = <color=FF9000>KSG-12</color>\r\n\r\n데미지는 조금 낮지만 연사력이 좋은 샷건입니다.\r\n\r\n돌격, 근거리 전투를 좋아하는 분에게 추천합니다.
10937 = <color=FF9000>MG43</color>\r\n\r\n넉넉한 탄창과 빠른 연사속도를 가진 총입니다.\r\n\r\n단, 무기가 무거워 착용 시 이동속도가 저하되고,\r\n\r\n총기반동이 크기 때문에 명중률이 낮은 총입니다.\r\n
10938 = <color=FF9000>어메이징 모드</color>\r\n\r\n이색적인 게임 룰로 구성이 되어있는 모드로\r\n\r\n뱀파이어 및 왕대두 모드가 대표적입니다.\r\n\r\n단, 기록 및 지령은 적용되지 않습니다.\r\n
10939 = <color=FF9000>협동 플레이</color>\r\n\r\n공룡, 좀비모드를 플레이할 수 있는 모드입니다.\r\n\r\n일반모드에 지치셨다면, 협동모드를 추천해 드립니다.\r\n\r\nAI와 전투하면서 스트레스를 날려보세요
10940 = <color=FF9000>AI Bot모드</color>\r\n\r\n컨트롤을 숙달하시기에 가장 안성맞춤인 모드입니다.\r\n\r\n인공지능 캐릭터들과 전투를 통해 게임을 익혀보세요\r\n\r\n아직 게임에 익숙하지 않은 분들에게 적극 추천합니다.
10941 = <color=FF9000>훈련소</color>\r\n\r\n서든어택이 처음이시라면 훈련소를 이용해보세요!\r\n\r\n기초/무기/전장/Ai Bot의 4가지 훈련을 통해\r\n\r\n게임 감각 및 컨트롤을 익혀보세요
10942 = <color=FF9000>기록방</color>\r\n\r\n기록방이란 전투기록이 저장되는 방으로\r\n\r\n기준옵션에서 8명 이상 참여한 방을 의미합니다.\r\n
10943 = <color=FF9000>기록실</color>\r\n\r\n기록/리플레이에서 일반, 용병, 클랜전에 대한\r\n\r\n상세한 전투기록과 공적현황에 대한 정보를\r\n\r\n확인하실 수 있습니다.
10944 = <color=FF9000> [칭호] </color>\r\n\r\n특정 공적을 달성하시면 칭호를 지급해 드립니다.\r\n\r\n획득한 칭호를 사용하면 닉네임 머리말에 표시되며\r\n\r\n남들보다 독특하게 꾸미실 수 있습니다.\r\n
10945 = <color=FF9000>지령</color>\r\n\r\n기록/리플레이를 통해 일일 지령을 받을 수 있으며,\r\n\r\n지령 완료 시 게임 경험치가 보상으로 제공됩니다.\r\n\r\n게임 내 지령상황판 단축키는 ‘K’입니다.\r\n
10946 = <color=FF9000>유니크 지령</color>\r\n\r\n전투, 첩보, 전장, 특수의 4가지 지령을 완료하시면\r\n\r\n유니크 지령을 받으실 수 있습니다.\r\n\r\n유니크 지령 완료 시 더 좋은 보상이 제공됩니다.
10947 = <color=FF9000>클랜전</color>\r\n\r\n게임 규칙은 공수교대 방식으로\r\n\r\n레드팀, 블루팀 각각 1번씩 전반, 후반으로 진행됩니다.\r\n\r\n일반전 보다 전략적인 재미를 느끼실 수 있습니다.
10948 = <color=FF9000>승급공적</color>\r\n\r\n승급공적에서 중대장~사령관의 공적을 달성할 수 있고\r\n\r\n달성한 공적에 따라 계급 테두리 색상과\r\n\r\n획득하신 칭호의 색상이 변경됩니다.
10949 = <color=FF9000>신고하기</color>\r\n\r\n불법프로그램 사용유저, 비매너 유저를 만나셨나요?\r\n\r\n신고하기 메뉴를 이용하세요. \r\n\r\n최대한 빠른 시간 안에 처리해 드리도록 하겠습니다.\r\n
10950 = <color=FF9000>용병전</color>\r\n\r\n다른 클랜간의 전투에 용병으로 참여할 수 있습니다.\r\n\r\n로비의 용병버튼을 통해 참여하실 수 있으며\r\n\r\n클랜전의 전략적인 재미를 느끼실 수 있습니다.
10951 = <color=FF9000>훈련소</color>\r\n\r\n서든어택이 처음이시라면 훈련소를 이용해보세요!\r\n\r\n기초/무기/전장/Ai Bot의 4가지 훈련을 통해\r\n\r\n게임감각 및 컨트롤을 익히실 수 있습니다.\r\n
10952 = <color=FF9000>클랜생성</color>\r\n\r\n하사계급을 달성하시면 클랜을 생성하실 수 있습니다.\r\n\r\n클랜 생성에는 30,000포인트가 필요한 점 참고하세요\r\n
10953 = <color=FF9000>클랜찾기</color>\r\n\r\n쉽게 클랜을 검색하고 가입해보세요.\r\n\r\n클랜찾기를 통해 클랜의 홍보내용을 확인할 수 있으며,\r\n\r\n검색기능을 통해 쉽게 원하는 클랜을 찾을 수 있습니다.
10954 = <color=FF9000>라이선스</color>\r\n\r\n라이선스를 달성해 보세요.\r\n\r\n로비의 기록/리플레이 메뉴를 통해 참여할 수 있으며\r\n\r\n라이선스를 취득하면 이쁜 칭호를 지급해 드립니다.
10955 = <color=FF9000>무기교체</color>\r\n\r\n게임 중 무기를 교체하고 싶으신가요?\r\n\r\n상점의 슬롯설정에서 교체하고 싶은 무기를 등록하세요.\r\n\r\n게임 중 무기교체시간에 해당 무기로 교체가 가능합니다.\r\n
10956 = <color=FF9000>클랜미션</color>\r\n\r\n클랜미션에 도전해보세요.\r\n\r\n클랜원들과 협동하여 미션을 달성하고,\r\n\r\n보상으로 제공되는 경험치 및 아이템을 사용해보세요
10957 = <color=FF9000>클랜원 랭킹</color>\r\n\r\n클랜전을 통해 획득한 점수로 소속 클랜원들과\r\n\r\n순위경쟁을 할 수 있으며, 주간 랭킹 1~3위는\r\n\r\n채팅 머리말에 메달이 표시됩니다.
10958 = AK47(IS) Se-gyung
10959 = AK47(IS)의 신세경 스킨 무기 상점에서 미판매 아이템\r\n[무기 속성]\r\nInfinity + Silencer\r\n
10960 = AK47(IS)의 신세경 스킨 무기\r\n\r\n상점에서 미판매 아이템\r\n\r\n\r\n[무기 속성]\r\n\r\nInfinity + Silencer\r\n
